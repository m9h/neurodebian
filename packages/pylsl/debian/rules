#!/usr/bin/make -f
# pylsl: pure-Python ctypes binding to liblsl, built with pybuild.

export PYBUILD_NAME = pylsl
# Built from a release tarball (no .git), so setuptools-scm cannot derive the
# version from VCS metadata: supply it explicitly.
export SETUPTOOLS_SCM_PRETEND_VERSION = 1.18.2
# Do not run the test suite at build time: it needs a live liblsl network
# endpoint (creating outlets/inlets), which is not available in a build chroot.
export PYBUILD_DISABLE = test

%:
	dh $@ --with python3 --buildsystem=pybuild
