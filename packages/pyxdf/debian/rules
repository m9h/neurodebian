#!/usr/bin/make -f
# pyxdf: pure-Python XDF reader, hatchling backend, built with pybuild.

export PYBUILD_NAME = pyxdf
# Built from a release tarball (no .git); hatch-vcs/setuptools-scm cannot derive
# the version from VCS metadata, so supply it explicitly.
export SETUPTOOLS_SCM_PRETEND_VERSION = 1.17.5

%:
	dh $@ --with python3 --buildsystem=pybuild
