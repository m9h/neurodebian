Description: Use the classic license table form for older hatchling
 Upstream uses the PEP 639 metadata (license = "<SPDX>" plus a license-files
 array). The hatchling shipped in Debian/Ubuntu rejects this ("license-files
 must be a table"). Convert to the long-supported license = { file = ... }
 form. The license itself is unchanged (BSD-2-Clause; see debian/copyright).
Author: Morgan Hough <morgan.hough@gmail.com>
Forwarded: not-needed
Last-Update: 2026-06-22
---
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -6,8 +6,7 @@
 name = "pyxdf"
 dynamic = ["version"]
 description = "Python package for importing XDF (Extensible Data Format) files"
-license = "BSD-2-Clause"
-license-files = ["LICENSE"]
+license = { file = "LICENSE" }
 authors = [
   { name = "Christian Kothe", email = "christian.kothe@intheon.io" },
   { name = "Chadwick Boulay", email = "chadwick.boulay@gmail.com" },
