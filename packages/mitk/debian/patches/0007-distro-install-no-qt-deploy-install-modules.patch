Index: mitk-2026.06/CMakeLists.txt
===================================================================
--- mitk-2026.06.orig/CMakeLists.txt
+++ mitk-2026.06/CMakeLists.txt
@@ -1592,3 +1592,21 @@ feature_summary(
   DESCRIPTION "------- FEATURE SUMMARY FOR ${PROJECT_NAME} -------"
   WHAT ALL
 )
+
+# ---- Distro packaging: install module libraries + headers ----
+# Upstream only installs the Workbench bundle (MITK_INSTALL_TARGETS with
+# GLOB_PLUGINS); module libraries and headers have no install rules of their
+# own. No install(EXPORT): mitk_create_module uses raw paths in
+# target_include_directories, which CMake rejects in an export set.
+get_property(_mitk_install_targets GLOBAL PROPERTY MITK_MODULE_TARGETS)
+if(_mitk_install_targets)
+  install(TARGETS ${_mitk_install_targets}
+          LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
+          RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+  foreach(_t ${_mitk_install_targets})
+    get_target_property(_src ${_t} SOURCE_DIR)
+    if(_src AND EXISTS ${_src}/include)
+      install(DIRECTORY ${_src}/include/ DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/mitk)
+    endif()
+  endforeach()
+endif()
