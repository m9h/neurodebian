+++ mitk-2026.06/Modules/Core/CMakeLists.txt
@@ -80,3 +80,8 @@ if(BUILD_TESTING)
   add_subdirectory(TestingHelper)
   add_subdirectory(test)
 endif()
+
+# Debian: ITK_IO_FACTORY_REGISTER_MANAGER auto-registers every IO factory the
+# system ITK enables, including ITKIODCMTK, which MitkCore's PACKAGE_DEPENDS does
+# not list (its parser prefixes "ITK" onto component names). Link it directly.
+target_link_libraries(MitkCore PRIVATE ITKIODCMTK)
