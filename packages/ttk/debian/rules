#!/usr/bin/make -f
# TTK (Tensor ToolKit, Inria) — built against system ITK 5.4.6 + VTK 9.5,
# ported from the neurofedora TTK.spec. Library-only (no executables).

include /usr/share/dpkg/architecture.mk
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# TTK's ITK/VTK glue trips modern-compiler strictness (vtkIdType const binding,
# ambiguous ApplyMatrix overloads, itk::Tensor rvalue binding); the upstream
# Fedora build relaxes these the same way.
export DEB_CXXFLAGS_MAINT_APPEND = -std=c++17 -include cstdint -fpermissive
ITK_DIR = /usr/lib/$(DEB_HOST_MULTIARCH)/cmake/ITK-5.4

%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- \
	  -DCMAKE_BUILD_TYPE=Release \
	  -DCMAKE_SKIP_INSTALL_RPATH=ON \
	  -DCMAKE_CXX_STANDARD=17 \
	  -DITK_DIR:PATH=$(ITK_DIR) \
	  -DBUILD_SHARED_LIBS=ON \
	  -DBUILD_EXECUTABLES=OFF \
	  -DTTK_USE_GMM=OFF \
	  -DTTK_USE_MKL=OFF \
	  -DTTK_USE_ACML=OFF

override_dh_auto_test:
