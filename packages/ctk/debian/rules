#!/usr/bin/make -f
include /usr/share/dpkg/architecture.mk
DH_VERBOSE=0

DPKG_EXPORT_BUILDFLAGS = 1
-include /usr/share/dpkg/buildflags.mk

export DEB_BUILD_MAINT_OPTIONS=hardening=+all

CMAKE_FLAGS = \
    -DCMAKE_BUILD_TYPE:STRING=Release \
    -DCMAKE_VERBOSE_MAKEFILE:BOOL=$(DH_VERBOSE) \
    -DCMAKE_INSTALL_PREFIX:PATH=/usr \
    -DCMAKE_SKIP_RPATH:BOOL=ON \
    -DBUILD_TESTING:BOOL=OFF \
    -DCTK_SUPERBUILD:BOOL=OFF \
    -DCTK_ENABLE_DICOM:BOOL=ON \
    -DCTK_ENABLE_PluginFramework:BOOL=ON \
    -DCTK_ENABLE_Widgets:BOOL=ON \
    -DCTK_QT_VERSION=6 \
    -DCTK_INSTALL_LIB_DIR=lib \
    -DCTK_INSTALL_INCLUDE_DIR=include/ctk \
    -DCTK_INSTALL_PLUGIN_DIR=/usr/lib/ctk/plugins \
    -DCTK_INSTALL_CMAKE_DIR=lib/$(DEB_HOST_MULTIARCH)/cmake/ctk \
    # Upstream default: "lib/ctk-0.1", "include/ctk-0.1", "lib/ctk-0.1/plugins" and "lib/ctk-0.1/CMake" but versioning seems pointless (https://github.com/commontk/CTK/issues/358#issuecomment-359455314)
    #-DDCMTK_DIR:PATH=/usr \
    #-DCTK_APP_ctkCommandLineModuleExplorer:BOOL=ON \
    #-DCTK_APP_ctkDICOM:BOOL=ON \
    #-DCTK_APP_ctkPluginBrowser:BOOL=ON \
    #-DCTK_APP_ctkPluginGenerator:BOOL=ON \
    #-DCTK_BUILD_QTDESIGNER_PLUGINS:BOOL=ON \
    #-DCTK_ENABLE_PluginFramework:BOOL=ON \
    #-DCTK_ENABLE_Python_Wrapping:BOOL=OFF \
    #-DCTK_ENABLE_Widgets:BOOL=ON \
    #-DCTK_LIB_CommandLineModules/Backend/FunctionPointer:BOOL=ON \
    #-DCTK_LIB_CommandLineModules/Backend/LocalProcess:BOOL=ON \
    #-DCTK_LIB_CommandLineModules/Core:BOOL=ON \
    #-DCTK_LIB_CommandLineModules/Frontend/QtGui:BOOL=ON \
    #-DCTK_LIB_CommandLineModules/Frontend/QtWebKit:BOOL=ON \
    #-DCTK_LIB_Core:BOOL=ON \
    #-DCTK_LIB_DICOM/Core:BOOL=ON \
    #-DCTK_LIB_DICOM/Widgets:BOOL=ON \
    #-DCTK_LIB_ImageProcessing/ITK/Core:BOOL=ON \
    #-DCTK_LIB_PluginFramework:BOOL=ON \
    #-DCTK_LIB_Scripting/Python/Core:BOOL=OFF \
    #-DCTK_LIB_Visualization/VTK/Core:BOOL=ON \
    #-DCTK_LIB_Visualization/VTK/Widgets:BOOL=ON \
    #-DCTK_LIB_Widgets:BOOL=ON \
    #-DCTK_PLUGIN_org.commontk.configadmin:BOOL=ON \
    #-DCTK_PLUGIN_org.commontk.eventadmin:BOOL=ON \
    #-DCTK_PLUGIN_org.commontk.log:BOOL=ON \
    #-DCTK_PLUGIN_org.commontk.metatype:BOOL=ON \
    #-DCTK_PLUGIN_org.commontk.plugingenerator.core:BOOL=ON \
    #-DCTK_PLUGIN_org.commontk.plugingenerator.ui:BOOL=ON \

pkg_run = libctk0.1
pkg_dev = libctk-dev

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- $(CMAKE_FLAGS)

#install/ctk-examples::
#	dh_installexamples -popenigtlink-examples Examples/

#install/ctk-doc::
#	doxygen -u $(DEB_BUILDDIR)/doxygen.config
#	doxygen $(DEB_BUILDDIR)/doxygen.config
#	dh_install -plibctk-doc       $(DEB_BUILDDIR)/Documents/Doxygen/html         usr/share/doc/ctk-doc


# --- DGraph -------------------------------------------------------------------
# CTK's plugin machinery (ctkMacroSetupPlugins -> ctkMacroValidateBuildOptions)
# runs a DGraph binary at configure time and aborts with "Executable doesn't
# exist!" unless CTK_DGRAPH_EXECUTABLE points at a real file. Upstream only
# builds DGraph via try_compile() into CTK's own build tree and
# Utilities/DGraph/CMakeLists.txt has no install() rule, so nothing reaches
# consumers: MITK's BlueBerry plugins cannot configure against installed CTK.
# Build the standalone utility (DGraph.cpp + ctkDependencyGraph.cpp, no Qt)
# and ship it as a build-time helper under libexec, not bin: no user runs
# it, and "DGraph" is too generic a name for the global bin namespace.
override_dh_auto_build:
	dh_auto_build
	cmake -S Utilities/DGraph -B obj-$(DEB_HOST_MULTIARCH)/DGraph \
	  -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=17
	cmake --build obj-$(DEB_HOST_MULTIARCH)/DGraph --parallel
	test -x obj-$(DEB_HOST_MULTIARCH)/DGraph/DGraph

override_dh_auto_install:
	dh_auto_install
	install -D -p -m 0755 obj-$(DEB_HOST_MULTIARCH)/DGraph/DGraph \
	  debian/tmp/usr/libexec/ctk/DGraph
	# Export the executable to consumers of the installed CTK. Two names are
	# in play: DGraph_EXECUTABLE is CTK's build-tree variable, and
	# CTK_DGRAPH_EXECUTABLE is what ctkMacroSetupPlugins actually reads; the
	# installed config defines neither.
	printf '%s\n' '' \
	  '# --- Debian: DGraph for consumers of the INSTALLED CTK ---' \
	  'if(NOT DGraph_EXECUTABLE)' \
	  '  find_program(DGraph_EXECUTABLE DGraph PATHS "/usr/libexec/ctk" NO_DEFAULT_PATH)' \
	  'endif()' \
	  'set(CTK_DGRAPH_EXECUTABLE "$${DGraph_EXECUTABLE}")' \
	  >> debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/ctk/CTKConfig.cmake
	grep -q 'set(CTK_DGRAPH_EXECUTABLE' debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/ctk/CTKConfig.cmake
	# CTK's install rules glob only *.cmake, but the installed macros reference
	# these templates via ${CTK_CMAKE_DIR}: the plugin machinery needs
	# MANIFEST.MF.in and the two .qrc.in files (else configure_file() fails per
	# plugin and no plugin target is created), the rest serve other consumers.
	# Found by grepping every ${CTK_CMAKE_DIR}/<file> reference in the installed
	# cmake and diffing against what is shipped.
	for f in MANIFEST.MF.in plugin_manifest.qrc.in plugin_resources_cached.qrc.in \
	         WindowsApplicationUseUtf8.manifest ctkMacroWrapPythonQtModuleInit.cpp.in \
	         ctkWrapPythonQt.py ctkCheckoutRepo.cmake.in CTKPluginUseFile.cmake.in; do \
	  install -p -m 0644 CMake/$$f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/ctk/; \
	done
	# ctkFunctionGeneratePluginUseFile looks for CTKPluginUseFile.cmake.in at
	# ${CTK_CMAKE_DIR}/../CMake/, a source-tree layout; point it at the cmake dir.
	sed -i 's|$${CTK_CMAKE_DIR}/../CMake/CTKPluginUseFile.cmake.in|$${CTK_CMAKE_DIR}/CTKPluginUseFile.cmake.in|' \
	  debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/ctk/ctkFunctionGeneratePluginUseFile.cmake
	grep -q 'CTK_CMAKE_DIR}/CTKPluginUseFile.cmake.in' debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/cmake/ctk/ctkFunctionGeneratePluginUseFile.cmake
	# The PluginFramework service/ headers (ctkEventAdmin, ctkApplicationHandle,
	# ctkLogStream, ...) are installed flattened like every other header, but
	# consumers include them by SOURCE-relative path because CTK's own build
	# tree puts each service/* directory on the include path -- and so does
	# the installed ctkPlugin.h itself (<service/log/ctkLogStream.h>). It
	# surfaces as a moc error first ("Undefined interface" on Q_INTERFACES),
	# since moc silently skips an include it cannot find. Ship the subtree
	# with its structure intact alongside the flattened copies.
	cp -a Libs/PluginFramework/service debian/tmp/usr/include/ctk/
	find debian/tmp/usr/include/ctk/service -type f ! -name '*.h' -delete
	test -f debian/tmp/usr/include/ctk/service/application/ctkApplicationHandle.h
	test -f debian/tmp/usr/include/ctk/service/log/ctkLogStream.h

override_dh_install:
	# Runtime Package
	dh_install -p$(pkg_run) usr/lib/*.so.*
	# Development Package
	dh_install -p$(pkg_dev) usr/include
	dh_install -p$(pkg_dev) usr/lib/lib*.so
	dh_install -p$(pkg_dev) usr/libexec/ctk
#	dh_install -plibctk-dev   debian/tmp/usr/lib/ctk-0.1/*.cmake                 usr/lib/ctk-0.1
