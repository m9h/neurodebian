# build outputs
*.deb
*.ddeb
*.buildinfo
*.changes
*.orig.tar.*
*.debian.tar.*
*.dsc
# build trees / staging
**/obj-*/
**/build/
**/BUILD/
**/debian/.debhelper/
**/debian/tmp/
**/debian/*/
**/debian/*.substvars
**/debian/*.log
**/debian/files
**/debian/debhelper-build-stamp
# local data
spec_meta.json
# re-include real packaging source dirs that the broad debian/*/ rule above drops
!**/debian/source/
!**/debian/patches/
!**/debian/upstream/
!**/debian/manpages/
!**/debian/tests/
**/debian/*.debhelper
